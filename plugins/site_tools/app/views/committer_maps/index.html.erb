<%# 관리 > 저장소 사용자 연결 — 저장소별 커미터 연결 현황, 지금 사용자 기준으로 일괄 갱신 %>
<h2><%= l(:label_committer_maps) %></h2>
<p class="subtitle"><%= l(:text_committer_maps) %></p>
<% if @rows.empty? %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% else %>
<% can = @rows.sum { |_, _, _, n| n } %>
<ul class="db_stats mt_kpi">
  <li><span><%= l(:label_committer_k_repos) %></span><strong><%= @rows.size %></strong></li>
  <li><span><%= l(:label_committer_k_mapped) %></span><strong><%= @rows.sum { |_, m, _, _| m } %></strong></li>
  <li><span><%= l(:label_committer_k_unmapped) %></span><strong><%= @rows.sum { |_, _, u, _| u.size } %></strong></li>
  <li><span><%= l(:label_committer_k_can) %></span><strong class="<%= 'qa_fail' if can.positive? %>"><%= can %></strong></li>
</ul>
<%= form_tag(refresh_committer_maps_path, :class => 'st_bar') do %>
  <label class="inline"><%= check_box_tag 'remap', '1', false %> <%= l(:label_committer_remap) %></label>
  <%= submit_tag l(:label_committer_refresh_all), :data => { :confirm => l(:text_committer_refresh_confirm) } %>
<% end %>
<div class="autoscroll">
<table class="list st_list">
  <thead><tr><th class="name"><%= l(:label_project) %></th><th><%= l(:label_repository) %></th><th><%= l(:label_committer_k_mapped) %></th><th><%= l(:label_committer_k_unmapped) %></th><th><%= l(:label_committer_k_can) %></th><th class="name"><%= l(:label_committer_unmapped_list) %></th><th></th></tr></thead>
  <tbody>
  <% @rows.each do |repo, mapped, unmapped, n| %>
    <tr>
      <td class="name"><%= link_to repo.project.name, project_path(repo.project) %></td>
      <td><%= repo.identifier.presence || l(:label_committer_default_repo) %> <span class="db_dim"><%= repo.scm_name %></span></td>
      <td><%= mapped %></td>
      <td><%= unmapped.size %></td>
      <td class="<%= 'qa_fail' if n.positive? %>"><%= n %></td>
      <td class="name"><span class="db_dim"><%= unmapped.first(12).join(', ') %><%= " 외 #{unmapped.size - 12}" if unmapped.size > 12 %></span></td>
      <td class="buttons"><%= link_to l(:label_committer_edit), committers_repository_path(repo) %></td>
    </tr>
  <% end %>
  </tbody>
</table>
</div>
<% end %>
<h3><%= l(:label_repo_export_logs) %></h3>
<% if @exports.empty? %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% else %>
<div class="autoscroll">
<table class="list st_list">
  <thead><tr><th><%= l(:label_date) %></th><th><%= l(:label_repo_export_who) %></th><th class="name"><%= l(:label_project) %></th><th class="name"><%= l(:label_repo_export_path) %></th><th><%= l(:label_revision) %></th><th><%= l(:label_repo_export_size) %></th><th><%= l(:field_status) %></th></tr></thead>
  <tbody>
  <% @exports.each do |x| %>
    <tr><td><%= format_time(x.created_at) %></td><td><%= x.user %></td><td class="name"><%= x.project&.name %></td><td class="name"><code>/<%= x.path %></code></td><td><%= x.rev %></td>
      <td><%= x.bytes ? number_to_human_size(x.bytes) : '-' %><% if x.files %> <span class="db_dim">(<%= x.files %>)</span><% end %></td>
      <td><% if x.status == 'ok' %><span class="mt_yn on">OK</span><% else %><span class="qa_fail" title="<%= x.message %>"><%= x.message.to_s.truncate(40) %></span><% end %></td></tr>
  <% end %>
  </tbody>
</table>
</div>
<% end %>
<% html_title l(:label_committer_maps) %>
