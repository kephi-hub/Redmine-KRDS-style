<%# 프로젝트 > 메뉴 구조도 > 현황 — 화면(말단 메뉴) 기준 일감 연결·완료·진행률, 1뎁스별·화면 유형별, 일감 없는 화면 %>
<h2><%= l(:label_menu_tree) %></h2>
<%= menu_view_tabs(:status) %>
<% if @ordered.empty? %>
<p class="nodata"><%= l(:label_menu_g_no_rows) %></p>
<% else %>
  <% own = @stats[:own]; linked = @leaves.select { |m| own[m.id] }; done = linked.select { |m| own[m.id][:closed] == own[m.id][:total] } %>
  <% ratio = linked.any? ? (linked.sum { |m| own[m.id][:ratio] } / linked.size.to_f).round : 0 %>
  <ul class="db_stats mt_kpi">
    <li><span><%= l(:label_menu_g_k_menus) %></span><strong><%= @ordered.size %></strong></li>
    <li><span><%= l(:label_menu_g_k_screens) %></span><strong><%= @leaves.size %></strong></li>
    <li><span><%= l(:label_menu_g_k_linked) %></span><strong><%= linked.size %> / <%= @leaves.size %></strong></li>
    <li><span><%= l(:label_menu_g_k_done) %></span><strong><%= done.size %></strong></li>
    <li><span><%= l(:label_menu_g_k_issues) %></span><strong><%= @stats[:issues].size %></strong></li>
    <li><span><%= l(:label_menu_g_k_ratio) %></span><strong><%= ratio %>%</strong></li>
  </ul>

  <h3 class="ag_sec"><%= l(:label_menu_st_by_root) %></h3>
  <div class="autoscroll">
  <table class="list mt_st">
    <thead><tr><th class="name"><%= l(:label_menu_st_root) %></th><th><%= l(:label_menu_g_k_screens) %></th><th><%= l(:label_menu_g_k_linked) %></th><th><%= l(:label_menu_g_k_done) %></th><th><%= l(:label_menu_g_issues) %></th><th class="bar"><%= l(:label_menu_g_progress) %></th></tr></thead>
    <tbody>
    <% @ordered.select { |_, d| d.zero? }.each do |root, _| %>
      <% leaves = @leaves.select { |m| @root_of[m.id] == root } %>
      <% lk = leaves.select { |m| own[m.id] }; dn = lk.select { |m| own[m.id][:closed] == own[m.id][:total] } %>
      <% tree = @stats[:tree][root.id] || {} %>
      <tr>
        <td class="name"><%= link_to root.name, project_menu_items_path(@project, :focus => root.id) %></td>
        <td><%= leaves.size %></td>
        <td><%= lk.size %></td>
        <td><%= dn.size %></td>
        <td><%= tree[:total].to_i %></td>
        <td class="bar"><%= menu_progress_bar(lk.any? ? (lk.sum { |m| own[m.id][:ratio] } / lk.size.to_f).round : 0) %></td>
      </tr>
    <% end %>
    </tbody>
  </table>
  </div>

  <h3 class="ag_sec"><%= l(:label_menu_st_by_type) %></h3>
  <ul class="db_tags">
    <% @leaves.group_by(&:screen_type).sort_by { |k, _| MenuItemsHelper::TYPE_KEYS.index(k) || 99 }.each do |type, list| %>
      <li><%= type ? l("label_menu_type_#{type}") : l(:label_menu_type_none) %> <span><%= list.size %></span></li>
    <% end %>
  </ul>

  <% empty = @leaves.select { |m| m.active? && !own[m.id] } %>
  <h3 class="ag_sec"><%= l(:label_menu_st_no_issue) %> <span class="mt_dim"><%= empty.size %></span></h3>
  <% if empty.empty? %>
    <p class="db_allsame"><%= l(:label_menu_st_all_linked) %></p>
  <% else %>
    <ul class="mt_nolist">
      <% empty.first(100).each do |m| %>
        <li><%= link_to m.path(@index), project_menu_items_path(@project, :focus => m.id) %><% if m.screen_id %> <code><%= m.screen_id %></code><% end %></li>
      <% end %>
    </ul>
    <% if empty.size > 100 %><p class="mt_dim"><%= l(:label_menu_st_more, :count => empty.size - 100) %></p><% end %>
  <% end %>
<% end %>
<% html_title "#{l(:label_menu_view_status)} - #{l(:label_menu_tree)}" %>
