<h2><%= link_to l(:label_pm_sec_scans), project_pm_sec_scans_path(@project) %> &#187; <%= link_to @scan.name, project_pm_sec_scan_path(@project, @scan) %></h2>
<%= labelled_form_for @scan, :url => project_pm_sec_scan_path(@project, @scan), :method => :patch do |f| %>
  <%= render :partial => 'pm_sec_scans/form', :locals => { :f => f } %>
  <p class="form_btns"><%= link_to l(:button_cancel), project_pm_sec_scan_path(@project, @scan), :class => 'btn_line' %><%= submit_tag l(:button_save) %></p>
<% end %>
<% html_title @scan.name %>
