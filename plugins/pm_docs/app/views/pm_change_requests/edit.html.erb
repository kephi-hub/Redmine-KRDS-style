<h2><%= link_to l(:label_pm_crs), project_pm_change_requests_path(@project) %> &#187; <%= link_to @cr.code, project_pm_change_request_path(@project, @cr) %> &#187; <%= l(:button_edit) %></h2>
<%= labelled_form_for @cr, :url => project_pm_change_request_path(@project, @cr), :method => :patch do |f| %>
  <%= render :partial => 'pm_change_requests/form', :locals => { :f => f } %>
  <p class="form_btns"><%= link_to l(:button_cancel), project_pm_change_request_path(@project, @cr), :class => 'btn_line' %><%= submit_tag l(:button_save) %></p>
<% end %>
<% html_title @cr.code %>
