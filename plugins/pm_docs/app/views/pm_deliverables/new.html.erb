<h2><%= link_to l(:label_pm_deliverables), project_pm_deliverables_path(@project) %> &#187; <%= l(:label_pm_deliv_new) %></h2>
<%= labelled_form_for @deliverable, :url => project_pm_deliverables_path(@project), :html => { :multipart => true } do |f| %>
  <%= render :partial => 'pm_deliverables/form', :locals => { :f => f } %>
  <p class="form_btns"><%= link_to l(:button_cancel), project_pm_deliverables_path(@project), :class => 'btn_line' %><%= submit_tag l(:button_create) %></p>
<% end %>
<% html_title l(:label_pm_deliv_new) %>
