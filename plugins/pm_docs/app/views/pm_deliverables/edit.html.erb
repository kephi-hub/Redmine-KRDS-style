<h2><%= link_to l(:label_pm_deliverables), project_pm_deliverables_path(@project) %> &#187; <%= link_to @deliverable.name, project_pm_deliverable_path(@project, @deliverable) %> &#187; <%= l(:button_edit) %></h2>
<%= labelled_form_for @deliverable, :url => project_pm_deliverable_path(@project, @deliverable), :method => :patch do |f| %>
  <%= render :partial => 'pm_deliverables/form', :locals => { :f => f } %>
  <p class="form_btns"><%= link_to l(:button_cancel), project_pm_deliverable_path(@project, @deliverable), :class => 'btn_line' %><%= submit_tag l(:button_save) %></p>
<% end %>
<% html_title @deliverable.name %>
