<h2><%= link_to l(:label_pm_programs), project_pm_programs_path(@project) %> &#187; <%= l(:label_pm_import) %></h2>
<%= form_tag project_pm_programs_import_path(@project), :multipart => true do %>
  <div class="box">
    <p><%= l(:text_pm_import) %></p>
    <p class="mt_help"><%= l(:text_pm_import_rules) %></p>
    <p><%= file_field_tag 'file', :accept => '.xlsx,.csv' %></p>
  </div>
  <p class="form_btns"><%= link_to l(:button_cancel), project_pm_programs_path(@project), :class => 'btn_line' %><%= submit_tag l(:label_pm_import) %></p>
<% end %>
<% if @result %>
  <ul class="db_stats mt_kpi">
    <li><span><%= l(:label_pm_imp_created) %></span><strong><%= @result[:created] %></strong></li>
    <li><span><%= l(:label_pm_imp_updated) %></span><strong><%= @result[:updated] %></strong></li>
    <li><span><%= l(:label_pm_imp_errors) %></span><strong class="<%= 'qa_fail' if @result[:errors].any? %>"><%= @result[:errors].size %></strong></li>
  </ul>
  <% if @result[:errors].any? %><ul class="mt_nolist"><% @result[:errors].first(200).each do |line, msg| %><li><%= line %>행 — <%= msg %></li><% end %></ul><% end %>
<% end %>
<% html_title l(:label_pm_import) %>
