<%# 프로젝트 > 프로그램 목록 %>
<% can_edit = User.current.allowed_to?(:manage_programs, @project) %>
<div class="contextual">
  <% if can_edit %><%= link_to sprite_icon('add', l(:label_pm_prog_new)), new_project_pm_program_path(@project), :class => 'icon icon-add' %>
    <%= link_to sprite_icon('import', l(:label_pm_import)), project_pm_programs_import_path(@project), :class => 'icon icon-import' %><% end %>
  <%= link_to sprite_icon('download', l(:label_pm_prog_export)), project_pm_programs_export_path(@project), :class => 'icon icon-download' %>
</div>
<h2><%= l(:label_pm_programs) %></h2>
<p class="subtitle"><%= l(:text_pm_programs) %></p>
<% done = @kpi['done'] + @kpi['tested'] %>
<ul class="db_stats mt_kpi">
  <li class="<%= 'on' unless @status %>"><%= link_to project_pm_programs_path(@project) do %><span><%= l(:label_pm_k_all) %></span><strong><%= @kpi['all'] %></strong><% end %></li>
  <% %w(todo dev done tested).each do |s| %>
    <li class="<%= 'on' if @status == s %>"><%= link_to project_pm_programs_path(@project, :status => s) do %><span><%= pm_label('pstatus', s) %></span><strong><%= @kpi[s] %></strong><% end %></li>
  <% end %>
  <li class="<%= 'on' if @status == 'nopath' %>"><%= link_to project_pm_programs_path(@project, :status => 'nopath') do %><span><%= l(:label_pm_k_nopath) %></span><strong><%= @kpi['nopath'] %></strong><% end %></li>
</ul>
<p class="db_info"><%= l(:label_pm_progress) %> <%= pm_bar(done, @kpi['all']) %>
  <% if can_edit && defined?(MenuItem) && @project.module_enabled?(:menu_tree) %> · <%= l(:label_pm_from_menus) %>
    <%= link_to l(:label_pm_by_screen), project_pm_programs_from_menus_path(@project, :mode => 'screen'), :method => :post, :class => 'pm_mk', :data => { :confirm => l(:text_pm_from_menus) } %>
    <%= link_to l(:label_pm_by_func), project_pm_programs_from_menus_path(@project, :mode => 'function'), :method => :post, :class => 'pm_mk', :data => { :confirm => l(:text_pm_from_menus_func) } %><% end %>
  <% if can_edit %>
    · <%= link_to l(:label_pm_suggest), project_pm_programs_suggest_path(@project) %><% end %></p>
<% if @by_dev.size > 1 %>
  <ul class="db_tags"><% @by_dev.each do |u, n, d| %><li><%= link_to (u ? u.name : l(:label_pm_no_dev)), project_pm_programs_path(@project, :developer_id => u&.id) %> <span><%= d %>/<%= n %></span></li><% end %></ul>
<% end %>
<%= form_tag(project_pm_programs_path(@project), :method => :get, :class => 'qa_filter') do %>
  <%= hidden_field_tag 'status', @status if @status %>
  <%= select_tag 'kind', options_for_select([[l(:label_pm_kind_all), '']] + pm_options('pkind', PmProgram::KINDS), @kind), :'aria-label' => l(:label_pm_kind) %>
  <%= search_field_tag 'q', @q, :placeholder => l(:label_pm_prog_search), :'aria-label' => l(:label_pm_prog_search) %>
  <%= submit_tag l(:label_pm_filter), :name => nil %>
<% end %>
<% if @programs.empty? %>
  <p class="nodata"><%= l(:label_no_data) %></p>
  <% if can_edit && @kpi['all'].zero? %><p class="db_hintbox"><%= l(:text_pm_prog_empty) %></p><% end %>
<% else %>
<div class="autoscroll">
<table class="list pm_list">
  <thead><tr><th><%= l(:label_pm_prog_code) %></th><th class="name"><%= l(:label_pm_prog_name) %></th><th><%= l(:label_pm_kind) %></th><th><%= l(:label_pm_paction) %></th><% unless @grouped %><th class="name"><%= l(:label_pm_menu) %></th><% end %><th><%= l(:label_pm_paths) %></th><th><%= l(:label_pm_developer) %></th><th><%= l(:field_status) %></th><th><%= l(:label_pm_planned) %></th><th></th></tr></thead>
  <tbody>
  <% groups = @grouped ? @programs.group_by(&:menu_item_id) : {} %>
  <% @programs.each do |p| %>
    <% m = @index[p.menu_item_id] %>
    <% if @grouped && p.menu_item_id != @prev_menu %><% @prev_menu = p.menu_item_id; g = groups[p.menu_item_id]; gd = g.count { |x| %w(done tested).include?(x.status) } %>
      <tr class="pm_grp"><th colspan="9"><%= m ? m.path(@index) : l(:label_pm_no_menu) %><% if m&.screen_id %> <code><%= m.screen_id %></code><% end %>
        <span class="pm_gcnt"><%= l(:label_pm_func_count, :count => g.size) %> · <%= l(:label_pm_func_done, :count => gd) %></span></th></tr>
    <% end %>
    <tr>
      <td class="code"><%= link_to p.code, project_pm_program_path(@project, p) %></td>
      <td class="name"><%= p.name %></td>
      <td><%= pm_label('pkind', p.kind) %></td>
      <td class="acts"><% p.action_list.each do |a| %><span class="pm_act"><%= pm_label('paction', a) %></span><% end %></td>
      <% unless @grouped %><td class="name"><% if m %><%= m.path(@index) %><% if m.screen_id %> <code><%= m.screen_id %></code><% end %><% end %></td><% end %>
      <td><%= p.paths.size.positive? ? p.paths.size : pm_badge(l(:label_pm_none), 'none') %></td>
      <td><%= p.developer %></td>
      <td><%= pm_badge(pm_label('pstatus', p.status), p.status) %></td>
      <td class="next"><%= format_date(p.planned_on) %></td>
      <td class="buttons"><% if can_edit %><%= link_to sprite_icon('edit', l(:button_edit)), edit_project_pm_program_path(@project, p), :class => 'icon icon-edit' %><% end %></td>
    </tr>
  <% end %>
  </tbody>
</table>
</div>
<% end %>
<% html_title l(:label_pm_programs) %>
