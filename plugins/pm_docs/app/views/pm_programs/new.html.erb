<h2><%= link_to l(:label_pm_programs), project_pm_programs_path(@project) %> &#187; <%= l(:label_pm_prog_new) %></h2>
<%= labelled_form_for @program, :url => project_pm_programs_path(@project) do |f| %>
  <%= render :partial => 'pm_programs/form', :locals => { :f => f } %>
  <p class="form_btns"><%= link_to l(:button_cancel), project_pm_programs_path(@project), :class => 'btn_line' %><%= submit_tag l(:label_pm_save_continue), :name => 'continue', :class => 'btn_line' %><%= submit_tag l(:button_create) %></p>
<% end %>
<% html_title l(:label_pm_prog_new) %>
