<h2><%= link_to l(:label_pm_meetings), project_pm_meetings_path(@project) %> &#187; <%= link_to @meeting.title, project_pm_meeting_path(@project, @meeting) %> &#187; <%= l(:button_edit) %></h2>
<%= labelled_form_for @meeting, :url => project_pm_meeting_path(@project, @meeting), :method => :patch do |f| %>
  <%= render :partial => 'pm_meetings/form', :locals => { :f => f } %>
  <p class="form_btns"><%= link_to l(:button_cancel), project_pm_meeting_path(@project, @meeting), :class => 'btn_line' %><%= submit_tag l(:button_save) %></p>
<% end %>
<% html_title @meeting.title %>
