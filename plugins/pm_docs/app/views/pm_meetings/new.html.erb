<h2><%= link_to l(:label_pm_meetings), project_pm_meetings_path(@project) %> &#187; <%= l(:label_pm_meeting_new) %></h2>
<%= labelled_form_for @meeting, :url => project_pm_meetings_path(@project) do |f| %>
  <%= render :partial => 'pm_meetings/form', :locals => { :f => f } %>
  <p class="form_btns"><%= link_to l(:button_cancel), project_pm_meetings_path(@project), :class => 'btn_line' %><%= submit_tag l(:button_create) %></p>
<% end %>
<% html_title l(:label_pm_meeting_new) %>
