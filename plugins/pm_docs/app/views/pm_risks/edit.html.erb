<h2><%= link_to l(:label_pm_risks), project_pm_risks_path(@project) %> &#187; <%= link_to @risk.code, project_pm_risk_path(@project, @risk) %> &#187; <%= l(:button_edit) %></h2>
<%= labelled_form_for @risk, :url => project_pm_risk_path(@project, @risk), :method => :patch do |f| %>
  <%= render :partial => 'pm_risks/form', :locals => { :f => f } %>
  <p class="form_btns"><%= link_to l(:button_cancel), project_pm_risk_path(@project, @risk), :class => 'btn_line' %><%= submit_tag l(:button_save) %></p>
<% end %>
<% html_title @risk.code %>
