<%# 프로젝트 > 이슈·위험 %>
<% can_edit = User.current.allowed_to?(:manage_risks, @project) %>
<div class="contextual">
  <% if can_edit %><%= link_to sprite_icon('add', l(:label_pm_risk_new)), new_project_pm_risk_path(@project), :class => 'icon icon-add' %>
    <%= link_to sprite_icon('add', l(:label_pm_issue_new)), new_project_pm_risk_path(@project, :kind => 'issue'), :class => 'icon icon-add' %><% end %>
  <%= link_to sprite_icon('download', l(:label_pm_risk_export)), project_pm_risks_export_path(@project), :class => 'icon icon-download' %>
</div>
<h2><%= l(:label_pm_risks) %></h2>
<p class="subtitle"><%= l(:text_pm_risks) %></p>
<ul class="db_stats mt_kpi">
  <li><%= link_to project_pm_risks_path(@project, :all => 1) do %><span><%= l(:label_pm_k_all) %></span><strong><%= @kpi[:all] %></strong><% end %></li>
  <li class="<%= 'on' unless @kind || @cell || params[:level] || params[:all] %>"><%= link_to project_pm_risks_path(@project) do %><span><%= l(:label_pm_k_open) %></span><strong><%= @kpi[:open] %></strong><% end %></li>
  <li class="<%= 'on' if params[:level] == 'high' %>"><%= link_to project_pm_risks_path(@project, :level => 'high') do %><span><%= l(:label_pm_k_high) %></span><strong class="<%= 'qa_fail' if @kpi[:high].positive? %>"><%= @kpi[:high] %></strong><% end %></li>
  <li class="<%= 'on' if @kind == 'issue' %>"><%= link_to project_pm_risks_path(@project, :kind => 'issue') do %><span><%= l(:label_pm_k_issue) %></span><strong><%= @kpi[:issue] %></strong><% end %></li>
  <li><span><%= l(:label_pm_k_late) %></span><strong class="<%= 'qa_fail' if @kpi[:late].positive? %>"><%= @kpi[:late] %></strong></li>
</ul>
<div class="pm_matrix_wrap">
  <table class="pm_matrix" aria-label="<%= l(:label_pm_matrix) %>">
    <caption><%= l(:label_pm_matrix) %></caption>
    <thead><tr><th scope="col"><%= l(:label_pm_prob) %> ＼ <%= l(:label_pm_impact_short) %></th><% [1, 2, 3].each do |i| %><th scope="col"><%= pm_label('phl', i) %></th><% end %></tr></thead>
    <tbody>
    <% [3, 2, 1].each do |pr| %>
      <tr><th scope="row"><%= pm_label('phl', pr) %></th>
        <% [1, 2, 3].each do |im| %><% n = @matrix[[pr, im]] %><% lv = pr * im >= 6 ? 'high' : (pr * im >= 3 ? 'mid' : 'low') %>
          <td data-k="<%= lv %>" class="<%= 'on' if @cell == [pr, im] %>"><%= n.positive? ? link_to(n, project_pm_risks_path(@project, :p => pr, :i => im)) : '' %></td>
        <% end %></tr>
    <% end %>
    </tbody>
  </table>
</div>
<% if @risks.empty? %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% else %>
<div class="autoscroll">
<table class="list pm_list">
  <thead><tr><th>ID</th><th><%= l(:label_pm_rkind) %></th><th class="name"><%= l(:label_pm_risk_title) %></th><th><%= l(:label_pm_level) %></th><th><%= l(:field_status) %></th><th><%= l(:label_pm_owner) %></th><th><%= l(:label_pm_due) %></th><th></th></tr></thead>
  <tbody>
  <% @risks.each do |r| %>
    <tr><td class="code"><%= link_to r.code, project_pm_risk_path(@project, r) %></td><td><%= pm_label('rkind', r.kind) %></td>
      <td class="name"><%= link_to r.title, project_pm_risk_path(@project, r) %></td>
      <td><%= pm_badge(pm_label('level', r.level), r.level) %> <span class="db_dim"><%= pm_label('phl', r.probability) %>×<%= pm_label('phl', r.impact) %></span></td>
      <td><%= pm_badge(pm_label('rstatus', r.status), "r#{r.status}") %></td><td><%= r.owner %></td>
      <td class="next <%= 'qa_fail' if r.open? && r.due_on && r.due_on < User.current.today %>"><%= format_date(r.due_on) %></td>
      <td class="buttons"><% if can_edit %><%= link_to sprite_icon('edit', l(:button_edit)), edit_project_pm_risk_path(@project, r), :class => 'icon icon-edit' %><% end %></td></tr>
  <% end %>
  </tbody>
</table>
</div>
<% end %>
<% html_title l(:label_pm_risks) %>
