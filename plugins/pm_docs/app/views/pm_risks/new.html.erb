<h2><%= link_to l(:label_pm_risks), project_pm_risks_path(@project) %> &#187; <%= l(@risk.kind == 'issue' ? :label_pm_issue_new : :label_pm_risk_new) %></h2>
<%= labelled_form_for @risk, :url => project_pm_risks_path(@project) do |f| %>
  <%= render :partial => 'pm_risks/form', :locals => { :f => f } %>
  <p class="form_btns"><%= link_to l(:button_cancel), project_pm_risks_path(@project), :class => 'btn_line' %><%= submit_tag l(:button_create) %></p>
<% end %>
<% html_title l(:label_pm_risk_new) %>
