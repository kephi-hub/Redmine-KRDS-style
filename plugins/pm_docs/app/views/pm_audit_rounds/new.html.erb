<h2><%= link_to l(:label_pm_audits), project_pm_audits_path(@project) %> &#187; <%= l(:label_pm_round_new) %></h2>
<%= labelled_form_for @round, :url => project_pm_audit_rounds_path(@project) do |f| %>
  <%= render :partial => 'pm_audit_rounds/form', :locals => { :f => f } %>
  <p class="form_btns"><%= link_to l(:button_cancel), project_pm_audits_path(@project), :class => 'btn_line' %><%= submit_tag l(:button_create) %></p>
<% end %>
<% html_title l(:label_pm_round_new) %>
