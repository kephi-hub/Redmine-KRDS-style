<div class="contextual"><%= link_to sprite_icon('del', l(:button_delete)), project_pm_audit_round_path(@project, @round), :method => :delete, :data => { :confirm => l(:text_are_you_sure) }, :class => 'icon icon-del' %></div>
<h2><%= link_to l(:label_pm_audits), project_pm_audits_path(@project) %> &#187; <%= @round.name %></h2>
<%= labelled_form_for @round, :url => project_pm_audit_round_path(@project, @round), :method => :patch do |f| %>
  <%= render :partial => 'pm_audit_rounds/form', :locals => { :f => f } %>
  <p class="form_btns"><%= link_to l(:button_cancel), project_pm_audits_path(@project), :class => 'btn_line' %><%= submit_tag l(:button_save) %></p>
<% end %>
<% html_title @round.name %>
