<h2><%= link_to l(:label_pm_audits), project_pm_audits_path(@project) %> &#187; <%= link_to @audit.code, project_pm_audit_path(@project, @audit) %></h2>
<%= labelled_form_for @audit, :url => project_pm_audit_path(@project, @audit), :method => :patch do |f| %>
  <%= render :partial => 'pm_audits/form', :locals => { :f => f } %>
  <p class="form_btns"><%= link_to l(:button_cancel), project_pm_audit_path(@project, @audit), :class => 'btn_line' %><%= submit_tag l(:button_save) %></p>
<% end %>
<% html_title "#{@audit.code} #{@audit.title}" %>
