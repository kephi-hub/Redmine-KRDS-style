<%# 프로젝트 > DB > 테이블 — 컬럼·키·용어사전 대조 %>
<h2><%= link_to l(:label_db_manage), project_db_schemas_path(@project, :link => @link.id) %> &#187; <%= @link.name %> &#187; <%= params[:table] %></h2>
<%= render :partial => 'error' %>
<% if @table %>
<p class="subtitle"><%= @table[:comment].presence || l(:label_db_no_comment) %><% if @table[:view] %> · <%= l(@table[:matview] ? :label_db_kind_matview : :label_db_kind_view) %><% end %><% unless @table[:view] %> · <%= l(:label_db_rows) %> <%= db_number(@table[:rows]) %><% end %></p>
<div class="autoscroll">
<table class="list db_cols">
  <thead><tr>
    <th>No</th>
    <th class="name"><%= l(:field_db_column) %></th>
    <th><%= l(:field_db_type) %></th>
    <th>Null</th>
    <th><%= l(:field_db_default) %></th>
    <th><%= l(:field_db_key) %></th>
    <th class="comment"><%= l(:field_db_comment) %></th>
    <% if @terms %><th><%= l(:label_glossary_short) %></th><% end %>
  </tr></thead>
  <tbody>
  <% @columns.each do |c| %>
    <tr class="db_col">
      <td class="pos"><%= c[:position] %></td>
      <td class="name"><code><%= c[:name] %></code></td>
      <td class="type"><%= c[:type] %></td>
      <td class="null"><%= c[:nullable] ? 'Y' : 'N' %></td>
      <td class="default"><%= c[:default] %></td>
      <td class="keys"><%= db_key_tags(c) %><% if c[:ref] %> <span class="db_ref">→ <%= c[:ref] %></span><% end %></td>
      <td class="comment"><%= c[:comment] %></td>
      <% if @terms %><td class="term"><%= db_term_tag(*DbManage::Analysis.term_status(c, @terms)) %></td><% end %>
    </tr>
  <% end %>
  </tbody>
</table>
</div>
<% idx = @snapshot[:indexes].to_h[@table[:name]] || [] %>
<% unless @table[:view] %>
  <h3 class="ag_sec"><%= l(:label_db_indexes) %> <span class="db_dim"><%= idx.size %></span></h3>
  <% if idx.empty? %><p class="db_hintbox"><%= l(:text_db_no_index) %></p><% else %>
  <div class="autoscroll">
  <table class="list db_cols db_idx">
    <thead><tr><th class="name"><%= l(:field_name) %></th><th><%= l(:label_db_idx_kind) %></th><th class="comment"><%= l(:label_db_idx_columns) %></th><th><%= l(:label_db_idx_method) %></th></tr></thead>
    <tbody>
    <% idx.each do |i| %>
      <tr class="db_col">
        <td class="name"><code><%= i[:name] %></code></td>
        <td class="kind"><span class="db_key <%= i[:primary] ? 'db_pk' : (i[:unique] ? 'db_uk' : 'db_ix') %>"><%= i[:primary] ? 'PK' : (i[:unique] ? 'UNIQUE' : 'INDEX') %></span></td>
        <td class="comment"><%= safe_join(i[:columns].each_with_index.map { |col, n| content_tag(:span, "#{n + 1}. #{col}", :class => 'db_idxcol') }, ' ') %></td>
        <td class="method"><%= i[:method] %></td>
      </tr>
    <% end %>
    </tbody>
  </table>
  </div>
  <% end %>
<% end %>
<% if @triggers.any? %>
  <h3 class="ag_sec"><%= l(:label_db_kind_trigger) %></h3>
  <ul class="db_tags"><% @triggers.each do |t| %><li><%= link_to t[:name], project_db_object_path(@project, @link, 'trigger', t[:key]) %> <span><%= t[:timing] %></span></li><% end %></ul>
<% end %>
<% if @table[:view] %>
  <h3 class="ag_sec"><%= l(:label_db_definition) %></h3>
  <% if @view && @view[:definition] %>
    <pre class="db_sql"><code><%= @view[:definition] %></code></pre>
  <% else %>
    <p class="db_hintbox"><%= l(:text_db_def_none) %></p>
  <% end %>
<% end %>
<% end %>
<% back_kind = @table ? (@table[:matview] ? 'matview' : (@table[:view] ? 'view' : 'table')) : 'table' %>
<p class="form_btns"><%= link_to l(:label_db_back_kind, :kind => l("label_db_kind_#{back_kind}")), project_db_schemas_path(@project, :link => @link.id, :kind => back_kind), :class => 'btn_line' %></p>
<% html_title "#{params[:table]} - #{l(:label_db_manage)}" %>
