<%# 프로젝트 > DB — DB 별 탭, 종류 탭(테이블·뷰·함수·프로시저·트리거·DB 잡·시퀀스 — DB 종류마다 다름), 그 아래 숫자 요약(KPI) %>
<h2><%= l(:label_db_manage) %></h2>
<p class="subtitle"><%= l(:text_db_project) %></p>

<% if @links.empty? %>
<%= render :partial => 'none' %>
<% else %>
<%= db_tabs(@link) %>
<div class="db_head">
  <p class="db_info"><%= db_link_info(@link) %><% if @link.db_server.ssh_enabled? %> · <%= l(:label_db_ssh_via, :route => @link.db_server.ssh_host) %><% end %></p>
  <p class="db_btns">
    <%= link_to sprite_icon('workflows', l(:label_db_erd)), project_db_erd_path(@project, @link), :class => 'btn_line' %>
    <%= link_to sprite_icon('time', l(:label_db_history)), project_db_history_path(@project, @link), :class => 'btn_line' %>
    <% if User.current.allowed_to?(@link.production? ? :run_db_query_production : :run_db_query, @project) %><%= link_to sprite_icon('search', l(:label_db_query)), project_db_query_path(@project, @link), :class => 'btn_line' %><% end %>
    <% if @terms %><%= link_to sprite_icon('checked', l(:label_db_check)), project_db_check_path(@project, @link), :class => 'btn_line' %><% end %>
    <%= link_to sprite_icon('lock', l(:label_db_privacy)), project_db_privacy_path(@project, @link), :class => 'btn_line' %>
    <%= link_to sprite_icon('download', l(:label_db_export)), project_db_export_path(@project, @link), :class => 'btn_line' %>
  </p>
</div>
<%= render :partial => 'error' %>
<% if @snapshot %>
  <p class="db_read"><%= l(:label_db_read_at, :time => format_time(@snapshot[:read_at])) %> · <%= link_to sprite_icon('reload', l(:label_db_refresh)), project_db_schemas_path(@project, :link => @link.id, :kind => @kind, :refresh => 1), :class => 'db_refresh' %></p>
  <% snap = @snapshot; cols = snap[:columns]; kinds = snap[:kinds].reject { |k| db_kind_items(snap, k).nil? } %>
  <div class="db_kinds" role="tablist">
    <% kinds.each do |kind| %>
      <a href="<%= project_db_schemas_path(@project, :link => @link.id, :kind => kind) %>" class="db_kind<%= ' on' if kind == @kind %>" data-kind="<%= kind %>" role="tab" aria-selected="<%= kind == @kind %>"><%= db_kind_label(kind) %><span class="db_kcnt"><%= db_kind_items(snap, kind).size %></span></a>
    <% end %>
  </div>
  <%# 숫자 요약(KPI): 종류별 개수(누르면 그 탭), 컬럼 수, 추정 행 수, 용어 일치 — 종류 탭 바로 아래 %>
  <% tables = db_kind_items(snap, 'table'); all_cols = cols.values.flatten; rows_sum = tables.sum { |t| t[:rows].to_i } %>
  <ul class="db_stats db_kpi">
    <% kinds.each do |kind| %>
      <li class="<%= 'on' if kind == @kind %>" data-kind="<%= kind %>"><a href="<%= project_db_schemas_path(@project, :link => @link.id, :kind => kind) %>" data-kind="<%= kind %>"><span><%= db_kind_label(kind) %></span><strong><%= db_number(db_kind_items(snap, kind).size) %></strong></a></li>
    <% end %>
    <li class="db_fixed"><span><%= l(:label_db_columns_total) %></span><strong><%= db_number(all_cols.size) %></strong></li>
    <li class="db_fixed"><span><%= l(:label_db_rows_total) %></span><strong><%= db_number(rows_sum) %></strong></li>
    <% if @terms && all_cols.any? %>
      <% okc = all_cols.count { |c| DbManage::Analysis.term_status(c, @terms).first == :ok } %>
      <li class="db_fixed"><span><%= l(:label_db_term_rate) %></span><strong><%= (okc * 100.0 / all_cols.size).round %>%</strong><em><%= okc %> / <%= all_cols.size %></em></li>
    <% end %>
  </ul>

  <div class="list_bar">
    <p class="list_total"><span id="db_shown"></span></p>
    <p class="list_search"><span class="list_field"><input type="search" id="db_filter" placeholder="<%= l(:label_db_filter_any) %>" aria-label="<%= l(:label_db_filter_any) %>"></span></p>
  </div>

  <% kinds.each do |kind| %>
  <% items = db_kind_items(snap, kind) %>
  <div class="db_panel" data-kind="<%= kind %>"<%= raw(' hidden') unless kind == @kind %>>
    <% if items.empty? %>
      <p class="nodata"><%= l(:label_db_none_kind, :kind => db_kind_label(kind)) %></p>
      <% if (hint = db_kind_hint(snap[:flavor], kind)) %><p class="db_hintbox"><%= hint %></p><% end %>
    <% else %>
    <div class="autoscroll">
    <table class="list db_list db_k_<%= kind %>">
      <% case kind %>
      <% when 'table', 'view', 'matview' %>
        <thead><tr>
          <th class="name"><%= db_kind_label(kind) %></th><th class="comment"><%= l(:field_db_comment) %></th><th><%= l(:label_db_columns) %></th>
          <% if kind == 'table' %><th><%= l(:label_db_rows) %></th><% end %>
          <% if @terms %><th><%= l(:label_db_term_match) %></th><% end %>
        </tr></thead>
        <tbody>
        <% items.each do |t| %>
          <% tc = cols[t[:name]] || [] %>
          <tr class="db_row" data-filter="<%= "#{t[:name]} #{t[:comment]}".downcase %>">
            <td class="name"><%= link_to t[:name], project_db_table_path(@project, @link, t[:name]) %></td>
            <td class="comment"><%= t[:comment] %></td>
            <td class="count"><%= tc.size %></td>
            <% if kind == 'table' %><td class="rows"><%= db_number(t[:rows]) %></td><% end %>
            <% if @terms %>
              <% ok = tc.count { |c| DbManage::Analysis.term_status(c, @terms).first == :ok } %>
              <td class="match"><span class="db_ratio<%= ' on' if tc.any? && ok == tc.size %>"><%= ok %> / <%= tc.size %></span></td>
            <% end %>
          </tr>
        <% end %>
        </tbody>
      <% when 'function', 'procedure' %>
        <thead><tr><th class="name"><%= l(:field_name) %></th><th class="args"><%= l(:label_db_args) %></th>
          <% if kind == 'function' %><th><%= l(:label_db_returns) %></th><% end %><th class="comment"><%= l(:field_db_comment) %></th><th><%= l(:label_db_definition) %></th></tr></thead>
        <tbody>
        <% items.each do |o| %>
          <tr class="db_row" data-filter="<%= "#{o[:name]} #{o[:comment]} #{o[:args]}".downcase %>">
            <td class="name"><%= link_to o[:name], db_object_path(@link, kind, o[:key]) %></td>
            <td class="args"><code><%= o[:args].presence || '()' %></code></td>
            <% if kind == 'function' %><td class="ret"><%= o[:returns] %></td><% end %>
            <td class="comment"><%= o[:comment] %></td>
            <td class="def"><%= o[:definition] ? content_tag(:span, l(:label_db_def_ok), :class => 'db_term db_ok') : content_tag(:span, l(:label_db_def_none), :class => 'db_term db_missing', :title => l(:text_db_def_none)) %></td>
          </tr>
        <% end %>
        </tbody>
      <% when 'trigger' %>
        <thead><tr><th class="name"><%= l(:field_name) %></th><th><%= l(:field_db_table) %></th><th><%= l(:label_db_timing) %></th><th><%= l(:field_status) %></th></tr></thead>
        <tbody>
        <% items.each do |o| %>
          <tr class="db_row" data-filter="<%= "#{o[:name]} #{o[:table]}".downcase %>">
            <td class="name"><%= link_to o[:name], db_object_path(@link, kind, o[:key]) %></td>
            <td class="tbl"><%= link_to o[:table], project_db_table_path(@project, @link, o[:table]) %></td>
            <td class="timing"><code><%= o[:timing] %></code></td>
            <td class="status"><%= db_status_tag(o[:status]) %></td>
          </tr>
        <% end %>
        </tbody>
      <% when 'event' %>
        <thead><tr><th class="name"><%= l(:field_name) %></th><th><%= l(:label_db_schedule) %></th><th><%= l(:field_status) %></th><th><%= l(:label_db_last_run) %></th><th class="comment"><%= l(:field_db_comment) %></th></tr></thead>
        <tbody>
        <% items.each do |o| %>
          <tr class="db_row" data-filter="<%= "#{o[:name]} #{o[:comment]}".downcase %>">
            <td class="name"><%= link_to o[:name], db_object_path(@link, kind, o[:key]) %></td>
            <td class="schedule"><%= o[:schedule] %></td>
            <td class="status"><%= db_status_tag(o[:status]) %></td>
            <td class="lastrun"><%= o[:last_run].presence || '-' %></td>
            <td class="comment"><%= o[:comment] %></td>
          </tr>
        <% end %>
        </tbody>
      <% when 'synonym', 'package' %>
        <thead><tr><th class="name"><%= l(:field_name) %></th><th class="comment"><%= l(kind == 'synonym' ? :label_db_target : :field_db_comment) %></th><th><%= l(:field_status) %></th></tr></thead>
        <tbody>
        <% items.each do |o| %>
          <tr class="db_row" data-filter="<%= "#{o[:name]} #{o[:target]}".downcase %>">
            <td class="name"><%= link_to o[:name], db_object_path(@link, kind, o[:key]) %></td>
            <td class="comment"><% if kind == 'synonym' %><code><%= o[:target] %></code><% else %><%= o[:comment] %><% end %></td>
            <td class="status"><%= db_status_tag(o[:status]) %></td>
          </tr>
        <% end %>
        </tbody>
      <% when 'sequence' %>
        <thead><tr><th class="name"><%= l(:field_name) %></th><th><%= l(:field_db_type) %></th><th><%= l(:label_db_seq_start) %></th><th><%= l(:label_db_seq_inc) %></th><th><%= l(:label_db_seq_max) %></th><th><%= l(:label_db_seq_cycle) %></th><th class="comment"><%= l(:label_db_seq_owned) %></th></tr></thead>
        <tbody>
        <% items.each do |o| %>
          <tr class="db_row" data-filter="<%= "#{o[:name]} #{o[:owned_by]}".downcase %>">
            <td class="name"><%= link_to o[:name], db_object_path(@link, kind, o[:key]) %></td>
            <td class="type"><%= o[:type] %></td>
            <td class="num"><%= db_number(o[:start]&.to_i) %></td>
            <td class="num"><%= o[:increment] %></td>
            <td class="num"><%= db_number(o[:max]&.to_i) %></td>
            <td class="cyc"><%= o[:cycle] ? 'Y' : 'N' %></td>
            <td class="comment"><%= o[:owned_by] || o[:comment] %></td>
          </tr>
        <% end %>
        </tbody>
      <% end %>
    </table>
    </div>
    <% end %>
    <p class="nodata db_nomatch" hidden><%= l(:label_no_data) %></p>
  </div>
  <% end %>


  <%= javascript_tag do %>
  $(function() {
    var shownText = <%= raw l(:label_db_shown, :kind => '__K__', :shown => '__S__', :total => '__T__').to_json %>;
    function current() { return $('.db_kind.on').data('kind'); }
    // 좁은 화면: 고른 종류 탭이 보이도록 가로 스크롤
    function reveal() {
      var a = $('.db_kind.on')[0]; if (!a) return;
      var box = a.parentNode; box.scrollLeft = a.offsetLeft - (box.clientWidth - a.offsetWidth) / 2;
    }
    function filter() {
      var q = $('#db_filter').val().toLowerCase().trim(), $p = $('.db_panel[data-kind="' + current() + '"]'), $rows = $p.find('tr.db_row'), n = 0;
      $rows.each(function() { var on = !q || String($(this).data('filter')).indexOf(q) >= 0; $(this).toggle(on); if (on) n++; });
      $p.find('.db_nomatch').prop('hidden', !($rows.length && n === 0));
      $('#db_shown').text(shownText.replace('__K__', $('.db_kind.on').contents().first().text()).replace('__S__', n).replace('__T__', $rows.length));
    }
    // 탭은 다시 접속하지 않고 화면에서 바꿈 (주소의 kind 만 바꿔 둠)
    $(document).on('click', 'a[data-kind]', function(e) {
      e.preventDefault();
      var k = $(this).data('kind');
      $('.db_kind').removeClass('on').attr('aria-selected', 'false').filter('[data-kind="' + k + '"]').addClass('on').attr('aria-selected', 'true');
      $('.db_kpi li[data-kind]').removeClass('on').filter('[data-kind="' + k + '"]').addClass('on');
      $('.db_panel').prop('hidden', true).filter('[data-kind="' + k + '"]').prop('hidden', false);
      try { history.replaceState(null, '', this.href); } catch (err) {}
      filter(); reveal();
    });
    $('#db_filter').on('input', filter);
    filter(); reveal();
  });
  <% end %>
<% end %>
<% end %>

<% html_title l(:label_db_manage) %>
