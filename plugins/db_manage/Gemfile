# DB 관리 플러그인 gem
# - mysql2: MariaDB·MySQL 접속 (공식 이미지에 이미 설치됨)
# - net-ssh (+ ed25519·bcrypt_pbkdf: ed25519 개인키): DB 서버 SSH 터널 — Dockerfile 이 이 파일로 이미지에 설치
gem 'mysql2', '~> 0.5.0'
gem 'net-ssh', '~> 7.3'
gem 'ed25519', '~> 1.3'
gem 'bcrypt_pbkdf', '~> 1.1'
# MS SQL Server 접속 (FreeTDS — 공식 이미지에 포함, Redmine Gemfile 과 같은 버전 조건)
gem 'tiny_tds', '~> 2.1.2'
# Oracle 접속 (Oracle Instant Client — Dockerfile 이 /opt/oracle/instantclient 에 설치)
gem 'ruby-oci8', '~> 2.2', require: false  # 처음 쓸 때 NLS_LANG(UTF-8) 을 정한 뒤 불러옴
