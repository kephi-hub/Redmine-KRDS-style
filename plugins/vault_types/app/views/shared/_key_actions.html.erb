<%# 접속정보 줄 버튼 (KRDS 아이콘 버튼) — 복제·삭제 (원본과 같은 권한·주소). 보기·편집은 이름 → 상세 화면 %>
<span class="vk_acts_in">
<% if key.project.nil? %>
  <% if User.current.admin? %>
    <%= link_to edit_orphaned_key_path(key), class: 'vk_btn', title: t('key.btn.move'), 'aria-label': t('key.btn.move') do %><%= sprite_icon('arrow-right') %><% end %>
    <%= link_to orphaned_key_path(key), class: 'vk_btn vk_del', title: t('button_delete'), 'aria-label': t('button_delete'), data: { confirm: t('confirm.key.delete') }, method: :delete do %><%= sprite_icon('del') %><% end %>
  <% else %>
    <span class="vk_btn is_off" title="<%= t('key.project_deleted') %>"><%= sprite_icon('link-break') %></span>
  <% end %>
<% else %>
  <%# 보기·편집은 이름을 눌러 상세 화면에서 (2026-11-13 사용자 요청으로 줄 버튼은 복제·삭제만) %>
  <% if User.current.allowed_to?(:edit_keys, key.project) %>
    <%= link_to project_copy_key_path(key.project, key), class: 'vk_btn', title: t('key.title.copy'), 'aria-label': t('key.title.copy') do %><%= sprite_icon('copy-link') %><% end %>
    <%= link_to project_key_path(key.project, key), class: 'vk_btn vk_del', title: t('button_delete'), 'aria-label': t('button_delete'), data: { confirm: t('confirm.key.delete') }, method: :delete do %><%= sprite_icon('del') %><% end %>
  <% end %>
<% end %>
</span>
