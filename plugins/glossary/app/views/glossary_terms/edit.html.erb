<h2><%= link_to (@project ? l(:label_glossary) : l(:label_glossary_common)), glossary_path_for(:index) %> &#187; <%= @term.name %></h2>
<%= labelled_form_for @term, :url => glossary_path_for(:member, @term), :html => { :method => :patch } do |f| %>
  <%= render :partial => 'form', :locals => { :f => f } %>
<% end %>
<% html_title @term.name %>
