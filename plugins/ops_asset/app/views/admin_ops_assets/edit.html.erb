<h2><%= link_to l(:label_oa_admin_assets), admin_ops_assets_path %> &#187; <%= @asset.name %><% unless @asset.shared? %> <span class="db_dim">(<%= @asset.project&.name %>)</span><% end %></h2>
<%= labelled_form_for @asset, :url => admin_ops_asset_path(@asset), :method => :patch do |f| %>
  <%= render :partial => 'ops_assets/form', :locals => { :f => f, :admin => true } %>
  <p class="form_btns">
    <%= link_to l(:button_delete), admin_ops_asset_path(@asset), :method => :delete, :data => { :confirm => l(:text_oa_asset_delete) }, :class => 'btn_line qa_danger' %>
    <%= link_to l(:button_cancel), admin_ops_assets_path, :class => 'btn_line' %><%= submit_tag l(:button_save) %></p>
<% end %>
<% html_title @asset.name %>
