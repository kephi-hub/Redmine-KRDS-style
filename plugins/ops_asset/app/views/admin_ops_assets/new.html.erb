<h2><%= link_to l(:label_oa_admin_assets), admin_ops_assets_path %> &#187; <%= l(:label_oa_shared_new) %></h2>
<%= labelled_form_for @asset, :url => admin_ops_assets_path do |f| %>
  <%= render :partial => 'ops_assets/form', :locals => { :f => f, :admin => true } %>
  <p class="form_btns"><%= link_to l(:button_cancel), admin_ops_assets_path, :class => 'btn_line' %><%= submit_tag l(:button_create) %></p>
<% end %>
<% html_title l(:label_oa_shared_new) %>
