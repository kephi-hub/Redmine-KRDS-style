<h2><%= link_to l(:label_oa_checks), project_ops_checks_path(@project) %> &#187; <%= link_to @check.name, project_ops_check_path(@project, @check) %> &#187; <%= l(:button_edit) %></h2>
<%= labelled_form_for @check, :url => project_ops_check_path(@project, @check), :method => :patch do |f| %>
  <%= render :partial => 'ops_checks/form', :locals => { :f => f } %>
  <p class="form_btns"><%= link_to l(:button_cancel), project_ops_check_path(@project, @check), :class => 'btn_line' %><%= submit_tag l(:button_save) %></p>
<% end %>
<% html_title @check.name %>
