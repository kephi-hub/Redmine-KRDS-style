<h2><%= link_to l(:label_oa_checks), project_ops_checks_path(@project) %> &#187; <%= l(:label_oa_check_new) %></h2>
<%= labelled_form_for @check, :url => project_ops_checks_path(@project) do |f| %>
  <%= render :partial => 'ops_checks/form', :locals => { :f => f } %>
  <p class="form_btns"><%= link_to l(:button_cancel), project_ops_checks_path(@project), :class => 'btn_line' %><%= submit_tag l(:button_create) %></p>
<% end %>
<% html_title l(:label_oa_check_new) %>
