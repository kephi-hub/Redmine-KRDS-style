<%# 프로젝트 > 스케줄러 — 목록 %>
<% can_edit = User.current.allowed_to?(:manage_ops_schedules, @project) %>
<%= render :partial => 'ops_schedules/head', :locals => { :current => :list } %>
<ul class="db_stats mt_kpi">
  <li><span><%= l(:label_oa_sk_all) %></span><strong><%= @kpi[:all] %></strong></li>
  <li><span><%= l(:label_oa_sk_active) %></span><strong><%= @kpi[:active] %></strong></li>
  <li><span><%= l(:label_oa_sk_servers) %></span><strong><%= @kpi[:servers] %></strong></li>
  <li><%= link_to project_ops_schedules_timeline_path(@project) do %><span><%= l(:label_oa_sk_today) %></span><strong><%= @today_runs %></strong><% end %></li>
  <li><span><%= l(:label_oa_sk_unparsed) %></span><strong class="<%= 'qa_fail' if @kpi[:unparsed].positive? %>"><%= @kpi[:unparsed] %></strong></li>
</ul>
<%= form_tag(project_ops_schedules_path(@project), :method => :get, :class => 'qa_filter') do %>
  <%= select_tag 'asset_id', options_for_select([[l(:label_oa_server_all), '']] + @assets.map { |a| [a.name, a.id] }, @asset_id), :'aria-label' => l(:label_oa_server) %>
  <%= select_tag 'kind', options_for_select([[l(:label_oa_kind_all), '']] + oa_options('skind', OpsSchedule::KINDS), @kind), :'aria-label' => l(:label_oa_kind) %>
  <%= search_field_tag 'q', @q, :placeholder => l(:label_oa_sched_search), :'aria-label' => l(:label_oa_sched_search) %>
  <label class="qa_chk"><%= check_box_tag 'all', '1', params[:all] == '1' %> <%= l(:label_oa_include_off) %></label>
  <%= submit_tag l(:label_oa_filter), :name => nil %>
<% end %>
<% if @schedules.empty? %>
  <p class="nodata"><%= l(:label_no_data) %></p>
  <% if can_edit && @kpi[:all].zero? %><p class="db_hintbox"><%= l(:text_oa_sched_empty) %></p><% end %>
<% else %>
<div class="autoscroll">
<table class="list oa_list">
  <thead><tr><th class="name"><%= l(:label_oa_sched_name) %></th><th><%= l(:label_oa_kind) %></th><th><%= l(:label_oa_server) %></th><th class="name"><%= l(:label_oa_expr) %></th><th><%= l(:label_oa_next) %></th><th><%= l(:label_oa_owner) %></th><th></th></tr></thead>
  <tbody>
  <% @schedules.each do |s| %>
    <% nxt = s.active? ? s.next_runs(1).first : nil %>
    <tr class="<%= 'qa_del' unless s.active? %>">
      <td class="name"><%= link_to s.name, project_ops_schedule_path(@project, s) %><% if s.command.present? %><span class="db_dim db_pvsub"><code><%= s.command.truncate(70) %></code></span><% end %></td>
      <td><%= oa_label('skind', s.kind) %><% if s.source != 'manual' %><span class="db_dim db_pvsub"><%= l("label_oa_src_#{s.source}") %></span><% end %></td>
      <td><%= s.ops_asset&.name %></td>
      <td class="name"><%= s.describe %><% if s.expression.present? %><span class="db_dim db_pvsub"><code><%= s.expression.truncate(60) %></code></span><% end %></td>
      <td class="next"><%= nxt ? oa_time(nxt) : '-' %></td>
      <td><%= s.owner %></td>
      <td class="buttons"><% if can_edit %><%= link_to sprite_icon('edit', l(:button_edit)), edit_project_ops_schedule_path(@project, s), :class => 'icon icon-edit' %><% end %></td>
    </tr>
  <% end %>
  </tbody>
</table>
</div>
<% end %>
<% html_title l(:label_oa_schedules) %>
