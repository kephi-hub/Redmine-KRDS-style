<h2><%= link_to l(:label_oa_interfaces), project_ops_interfaces_path(@project) %> &#187; <%= link_to @interface.code, project_ops_interface_path(@project, @interface) %> &#187; <%= l(:button_edit) %></h2>
<%= labelled_form_for @interface, :url => project_ops_interface_path(@project, @interface), :method => :patch do |f| %>
  <%= render :partial => 'ops_interfaces/form', :locals => { :f => f } %>
  <p class="form_btns"><%= link_to l(:button_cancel), project_ops_interface_path(@project, @interface), :class => 'btn_line' %><%= submit_tag l(:button_save) %></p>
<% end %>
<% html_title @interface.code %>
