<h2><%= link_to l(:label_oa_interfaces), project_ops_interfaces_path(@project) %> &#187; <%= l(:label_oa_if_new) %></h2>
<%= labelled_form_for @interface, :url => project_ops_interfaces_path(@project) do |f| %>
  <%= render :partial => 'ops_interfaces/form', :locals => { :f => f } %>
  <p class="form_btns"><%= link_to l(:button_cancel), project_ops_interfaces_path(@project), :class => 'btn_line' %><%= submit_tag l(:label_oa_save_continue), :name => 'continue', :class => 'btn_line' %><%= submit_tag l(:button_create) %></p>
<% end %>
<% html_title l(:label_oa_if_new) %>
