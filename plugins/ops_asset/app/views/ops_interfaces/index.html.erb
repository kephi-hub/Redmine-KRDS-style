<% can_edit = User.current.allowed_to?(:manage_ops_interfaces, @project) %>
<%= render :partial => 'ops_interfaces/head', :locals => { :current => :list } %>
<ul class="db_stats mt_kpi">
  <li><span><%= l(:label_oa_fk_all) %></span><strong><%= @kpi[:all] %></strong></li>
  <li><span><%= l(:label_oa_fk_partners) %></span><strong><%= @kpi[:partners] %></strong></li>
  <li><span><%= l(:label_oa_fk_send) %></span><strong><%= @kpi[:send] %></strong></li>
  <li><span><%= l(:label_oa_fk_recv) %></span><strong><%= @kpi[:recv] %></strong></li>
  <li><span><%= l(:label_oa_fk_realtime) %></span><strong><%= @kpi[:realtime] %></strong></li>
</ul>
<%= form_tag(project_ops_interfaces_path(@project), :method => :get, :class => 'qa_filter') do %>
  <%= select_tag 'partner', options_for_select([[l(:label_oa_partner_all), '']] + @partners, @partner), :'aria-label' => l(:label_oa_partner) %>
  <%= search_field_tag 'q', @q, :placeholder => l(:label_oa_if_search), :'aria-label' => l(:label_oa_if_search) %>
  <%= submit_tag l(:label_oa_filter), :name => nil %>
<% end %>
<% if @interfaces.empty? %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% else %>
<div class="autoscroll">
<table class="list oa_list">
  <thead><tr><th>ID</th><th class="name"><%= l(:label_oa_if_name) %></th><th><%= l(:label_oa_direction) %></th><th class="name"><%= l(:label_oa_partner) %></th><th><%= l(:label_oa_protocol) %></th><th><%= l(:label_oa_cycle) %></th><th><%= l(:field_status) %></th><th></th></tr></thead>
  <tbody>
  <% @interfaces.each do |i| %>
    <tr class="<%= 'qa_del' if i.status == 'stopped' %>">
      <td class="code"><%= link_to i.code, project_ops_interface_path(@project, i) %></td>
      <td class="name"><%= link_to i.name, project_ops_interface_path(@project, i) %><% if i.data_desc.present? %><span class="db_dim db_pvsub"><%= i.data_desc.truncate(60) %></span><% end %></td>
      <td><%= oa_badge(oa_label('direction', i.direction), i.direction) %></td>
      <td class="name"><%= i.partner %></td>
      <td><%= oa_label('protocol', i.protocol) %></td>
      <td><%= oa_label('cycle', i.cycle) %><% if i.ops_schedule %><span class="db_dim db_pvsub"><%= i.ops_schedule.describe %></span><% end %></td>
      <td><%= oa_label('istatus', i.status) %></td>
      <td class="buttons"><% if can_edit %><%= link_to sprite_icon('edit', l(:button_edit)), edit_project_ops_interface_path(@project, i), :class => 'icon icon-edit' %><% end %></td>
    </tr>
  <% end %>
  </tbody>
</table>
</div>
<% end %>
<% html_title l(:label_oa_interfaces) %>
