<h2><%= link_to l(:label_oa_assets), project_ops_assets_path(@project) %> &#187; <%= l(:label_oa_asset_new) %></h2>
<%= labelled_form_for @asset, :url => project_ops_assets_path(@project) do |f| %>
  <%= render :partial => 'ops_assets/form', :locals => { :f => f } %>
  <p class="form_btns"><%= link_to l(:button_cancel), project_ops_assets_path(@project), :class => 'btn_line' %><%= submit_tag l(:button_create) %></p>
<% end %>
<% html_title l(:label_oa_asset_new) %>
