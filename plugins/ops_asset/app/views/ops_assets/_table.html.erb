<%# 자산 표 (locals: assets, admin, can_edit) %>
<div class="autoscroll">
<table class="list oa_list">
  <thead><tr><th><%= l(:label_oa_kind) %></th><th class="name"><%= l(:label_oa_name) %></th><th><%= l(:label_oa_env) %></th><th class="name"><%= l(:label_oa_address) %></th><th><%= l(:label_oa_owner) %></th><th><%= l(:label_oa_expires) %></th><th><%= admin ? l(:label_oa_belongs) : l(:label_oa_scope) %></th><th></th></tr></thead>
  <tbody>
  <% assets.each do |a| %>
    <tr class="<%= 'qa_del' unless a.active? %>">
      <td class="kind"><%= oa_badge(oa_label('kind', a.kind), a.kind) %></td>
      <td class="name"><strong><%= a.name %></strong><% if a.spec.present? %><span class="db_dim db_pvsub"><%= a.spec.truncate(60) %></span><% end %>
        <% if (si = a.server_info_h) %><span class="oa_probe"><%= si['host'] %><% if si['uptime_days'] %> · <%= l(:label_oa_uptime, n: si['uptime_days']) %><% end %>
          <% (si['disks'] || []).first(4).each do |d| %> · <span class="<%= 'oa_warn' if d['pct'].to_i >= OpsKit::Probe::DISK_WARN %>"><%= d['mount'] %> <%= d['pct'] %>%</span><% end %>
          <span class="db_dim">(<%= format_date(a.info_at) %>)</span></span>
        <% elsif a.info_error.present? %><span class="oa_probe oa_warn"><%= l(:label_oa_collect_fail) %>: <%= a.info_error.truncate(80) %></span><% end %>
        <% if (ci = a.cert_info_h) %><span class="oa_probe"><%= l(:label_oa_cert_info, date: ci['not_after'], subject: ci['subject'], issuer: ci['issuer']) %><% unless ci['match'] %> <span class="oa_warn"><%= l(:label_oa_cert_mismatch) %></span><% end %> <span class="db_dim">(<%= format_date(a.cert_at) %>)</span></span>
        <% elsif a.cert_error.present? %><span class="oa_probe oa_warn"><%= l(:label_oa_cert_fail) %>: <%= a.cert_error.truncate(80) %></span><% end %></td>
      <td><%= oa_label('env', a.env) %></td>
      <td class="name"><%= a.address %><% if a.vendor.present? %><span class="db_dim db_pvsub"><%= a.vendor %></span><% end %></td>
      <td><%= a.owner %></td>
      <td class="exp"><%= oa_expiry(a) %><% if a.renew_cycle.present? %><span class="db_dim db_pvsub"><%= a.renew_cycle %></span><% end %></td>
      <td class="scope">
        <% if admin %><%= a.shared? ? oa_badge(l(:label_oa_shared), 'shared') : a.project&.name %><% if a.shared? && a.linked_projects.any? %><span class="db_dim db_pvsub"><%= a.linked_projects.map(&:name).join(', ') %></span><% end %>
        <% else %><%= a.shared? ? oa_badge(l(:label_oa_shared), 'shared') : l(:label_oa_project_own) %><% end %>
      </td>
      <td class="buttons">
        <% if admin %>
          <%= link_to sprite_icon('edit', l(:button_edit)), edit_admin_ops_asset_path(a), :class => 'icon icon-edit' %>
        <% elsif can_edit && !a.shared? %>
          <% if a.kind == 'server' && a.vault_key_id %><%= link_to sprite_icon('reload', l(:label_oa_collect)), project_ops_asset_collect_path(@project, a), :method => :post, :class => 'icon icon-reload' %><% end %>
          <% if a.cert_checkable? %><%= link_to sprite_icon('krds-lock', l(:label_oa_cert_check)), project_ops_asset_cert_path(@project, a), :method => :post, :class => 'icon' %><% end %>
          <%= link_to sprite_icon('edit', l(:button_edit)), edit_project_ops_asset_path(@project, a), :class => 'icon icon-edit' %>
        <% elsif can_edit && a.shared? %>
          <%= link_to sprite_icon('link-break', l(:label_oa_unlink)), project_ops_asset_unlink_path(@project, a), :method => :delete, :data => { :confirm => l(:text_oa_unlink) }, :class => 'icon icon-link-break' %>
        <% end %>
      </td>
    </tr>
  <% end %>
  </tbody>
</table>
</div>
