<h2><%= link_to l(:label_oa_assets), project_ops_assets_path(@project) %> &#187; <%= @asset.name %></h2>
<%= labelled_form_for @asset, :url => project_ops_asset_path(@project, @asset), :method => :patch do |f| %>
  <%= render :partial => 'ops_assets/form', :locals => { :f => f } %>
  <p class="form_btns">
    <%= link_to l(:button_delete), project_ops_asset_path(@project, @asset), :method => :delete, :data => { :confirm => l(:text_oa_asset_delete) }, :class => 'btn_line qa_danger' %>
    <%= link_to l(:button_cancel), project_ops_assets_path(@project), :class => 'btn_line' %><%= submit_tag l(:button_save) %></p>
<% end %>
<% html_title @asset.name %>
