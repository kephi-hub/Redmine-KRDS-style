<h2><%= link_to l(:label_oa_incidents), project_ops_incidents_path(@project) %> &#187; <%= link_to @incident.title, project_ops_incident_path(@project, @incident) %> &#187; <%= l(:button_edit) %></h2>
<%= labelled_form_for @incident, :url => project_ops_incident_path(@project, @incident), :method => :patch do |f| %>
  <%= render :partial => 'ops_incidents/form', :locals => { :f => f } %>
  <p class="form_btns"><%= link_to l(:button_cancel), project_ops_incident_path(@project, @incident), :class => 'btn_line' %><%= submit_tag l(:button_save) %></p>
<% end %>
<% html_title @incident.title %>
