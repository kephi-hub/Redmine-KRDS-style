<h2><%= link_to l(:label_oa_incidents), project_ops_incidents_path(@project) %> &#187; <%= l(:label_oa_incident_new) %></h2>
<%= labelled_form_for @incident, :url => project_ops_incidents_path(@project) do |f| %>
  <%= render :partial => 'ops_incidents/form', :locals => { :f => f } %>
  <p class="form_btns"><%= link_to l(:button_cancel), project_ops_incidents_path(@project), :class => 'btn_line' %><%= submit_tag l(:button_create) %></p>
<% end %>
<% html_title l(:label_oa_incident_new) %>
