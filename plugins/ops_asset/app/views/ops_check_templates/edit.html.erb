<h2><%= link_to l(:label_oa_checks), project_ops_checks_path(@project) %> &#187; <%= @template.name %></h2>
<%= labelled_form_for @template, :url => project_ops_check_template_path(@project, @template), :method => :patch do |f| %>
  <%= render :partial => 'ops_check_templates/form', :locals => { :f => f } %>
  <p class="form_btns">
    <%= link_to l(:button_delete), project_ops_check_template_path(@project, @template), :method => :delete, :data => { :confirm => l(:text_oa_tpl_delete) }, :class => 'btn_line qa_danger' %>
    <%= link_to l(:button_cancel), project_ops_checks_path(@project), :class => 'btn_line' %><%= submit_tag l(:button_save) %></p>
<% end %>
<% html_title @template.name %>
