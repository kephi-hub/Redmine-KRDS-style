<%# 실행 기록 표 (locals: runs, show_job) %>
<% can_edit = User.current.allowed_to?(:manage_sys_backups, @project) %>
<div class="autoscroll">
<table class="list pm_list sb_runs">
  <thead><tr><th><%= l(:label_sb_at) %></th><% if show_job %><th class="name"><%= l(:label_sb_job) %></th><% end %><th><%= l(:field_status) %></th>
    <th><%= l(:label_sb_got) %></th><th><%= l(:label_sb_files) %></th><th><%= l(:label_sb_time) %></th><th><%= l(:label_sb_by) %></th><th></th></tr></thead>
  <tbody>
  <% runs.each do |r| %>
    <% lv = r.busy? ? SshConsole::BackupView.live(r) : nil %>
    <tr class="sb_row<%= ' on' if lv %>"<% if lv %> data-run="<%= r.id %>" data-start="<%= lv[:start] %>"<% end %>>
      <td><%= format_time(r.started_at || r.created_at) %></td>
      <% if show_job %><td class="name"><%= link_to r.sys_backup_job.name, project_sys_backup_path(@project, r.sys_backup_job) %></td><% end %>
      <td><span class="sb_st" data-k="<%= r.status %>"><% if lv %><i class="sb_spin" aria-hidden="true"></i><% end %><span class="sb_stt"><%= l("label_sb_st_#{r.status}") %></span></span><% if lv %><span class="sb_prog<%= ' wait' unless lv[:pct] %>" role="progressbar" aria-valuemin="0" aria-valuemax="100"<% if lv[:pct] %> aria-valuenow="<%= lv[:pct] %>"<% end %> aria-label="<%= l(:label_sb_st_running) %>"><i<% if lv[:pct] %> style="width:<%= lv[:pct] %>%"<% end %>></i></span><% end %><% if r.error.present? %><br><span class="mc_err"><%= r.error.truncate(160) %></span><% end %></td>
      <td><% if lv %><span class="sb_vb"><%= number_to_human_size(r.bytes) if r.bytes.to_i.positive? %></span><% elsif r.status == 'done' %><%= number_to_human_size(r.bytes) %><% if r.total_bytes > r.bytes %><span class="mt_dim db_pvsub"><%= l(:label_sb_total, size: number_to_human_size(r.total_bytes)) %></span><% end %><% end %></td>
      <td><% if lv && r.sys_backup_job.files? %><span class="sb_vf"><%= l(:label_sb_files_n, total: r.files_total, new: r.files_new, linked: r.files_linked) if r.files_total.to_i.positive? %></span><% elsif r.status == 'done' && r.sys_backup_job.files? %><%= l(:label_sb_files_n, total: r.files_total, new: r.files_new, linked: r.files_linked) %><% end %></td>
      <td><% s = r.seconds %><% if lv %><span class="sb_vt"><%= format('%d:%02d', s.to_i / 60, s.to_i % 60) %></span><% if lv[:est] %><span class="mt_dim sb_est"> / <%= l(:label_sb_est, t: format('%d:%02d', lv[:est] / 60, lv[:est] % 60)) %></span><% end %><% elsif s %><%= format('%d:%02d', s / 60, s % 60) %><% end %></td>
      <td><%= r.trigger == 'schedule' ? l(:label_sb_by_schedule) : r.user&.name %></td>
      <td class="buttons">
        <% if r.status == 'done' && r.sys_backup_job.db? %><%= link_to sprite_icon('download', l(:label_sb_download)), project_sys_backup_download_path(@project, r.id), class: 'icon icon-download' %><% end %>
        <% if can_edit && !r.busy? %><%= link_to sprite_icon('del', l(:button_delete)), project_sys_backup_run_path(@project, r.id), method: :delete, data: { confirm: l(:text_sb_delete_run) }, class: 'icon icon-del' %><% end %>
      </td>
    </tr>
  <% end %>
  </tbody>
</table>
</div>
<% if runs.any?(&:busy?) %>
<%= javascript_tag do %>
// 진행 중 실행: 경과 시간 1초마다, 받은 양·파일 수·진행 막대는 2초마다 조용히 갱신, 끝나면 한 번 새로 고침
$(function() {
  var url = '<%= j project_sys_backups_status_path(@project) %>', tpl = '<%= j l(:label_sb_files_n, total: '%T', new: '%N', linked: '%L') %>';
  var st = <%= raw({ 'queued' => l(:label_sb_st_queued), 'running' => l(:label_sb_st_running) }.to_json) %>;
  function hs(b) { var u = ['Bytes', 'KB', 'MB', 'GB', 'TB'], i = 0; while (b >= 1024 && i < u.length - 1) { b /= 1024; i++; } return (i ? b.toFixed(b < 10 ? 1 : 0) : b) + ' ' + u[i]; }
  function mmss(s) { return Math.floor(s / 60) + ':' + ('0' + (s % 60)).slice(-2); }
  function nf(n) { return Number(n).toLocaleString('ko-KR'); }
  var tick = setInterval(function() {
    $('tr.sb_row.on').each(function() { var s0 = $(this).data('start'); if (s0) $(this).find('.sb_vt').text(mmss(Math.max(0, Math.floor(Date.now() / 1000) - s0))); });
  }, 1000);
  var poll = setInterval(function() {
    var ids = $('tr.sb_row.on').map(function() { return $(this).data('run'); }).get();
    if (!ids.length) { clearInterval(poll); clearInterval(tick); return; }
    $.ajax({ url: url, data: { ids: ids.join(',') }, dataType: 'json', global: false, cache: false }).done(function(list) {
      var finished = false;
      $.each(list, function(_, d) {
        var $tr = $('tr.sb_row.on[data-run=' + d.id + ']');
        if (!d.active) { finished = true; return; }
        if (d.start) $tr.attr('data-start', d.start).data('start', d.start);
        $tr.find('.sb_st').attr('data-k', d.status).find('.sb_stt').text(st[d.status] || d.status);
        if (d.bytes > 0) $tr.find('.sb_vb').text(hs(d.bytes));
        if (d.files && d.files_total > 0) $tr.find('.sb_vf').text(tpl.replace('%T', nf(d.files_total)).replace('%N', nf(d.files_new)).replace('%L', nf(d.files_linked)));
        var $p = $tr.find('.sb_prog');
        if (d.pct !== null && d.pct !== undefined) { $p.removeClass('wait').attr('aria-valuenow', d.pct).find('i').css('width', d.pct + '%'); }
      });
      if (finished) { clearInterval(poll); clearInterval(tick); location.reload(); }
    });
  }, 2000);
});
<% end %>
<% end %>
