<%# 시스템 백업 작업 편집 — 목록 카드에서 바로 들어옴. 위 [지금 백업]·[삭제], 아래 복원 방법·실행 기록(실시간) %>
<% j = @job %>
<div class="contextual">
  <% if @busy %><span class="icon btn_main is_off"><%= sprite_icon('reload', l(:label_sb_st_running)) %></span>
  <% else %><%= link_to sprite_icon('save', l(:button_sb_run)), project_sys_backup_run_now_path(@project, j), method: :post, class: 'icon icon-save btn_main', data: { confirm: l(:text_sb_run_confirm) } %><% end %>
  <%= link_to sprite_icon('del', l(:button_delete)), project_sys_backup_path(@project, j), method: :delete, data: { confirm: l(:text_sb_delete_job) }, class: 'icon icon-del' %>
</div>
<h2><%= link_to l(:label_sb), project_sys_backups_path(@project) %> &#187; <%= j.name_was.presence || j.name %></h2>
<%= labelled_form_for @job, url: project_sys_backup_path(@project, @job), html: { method: :patch, id: 'sb_form' } do |f| %>
  <%= render partial: 'sys_backups/form', locals: { f: f } %>
  <p class="form_btns"><%= link_to l(:button_cancel), project_sys_backups_path(@project), class: 'btn_line' %><%= submit_tag l(:button_sb_save_run), name: 'run_now', class: 'btn_line', data: { confirm: l(:text_sb_run_confirm) } %><%= submit_tag l(:button_save) %></p>
<% end %>
<div class="sb_hist">
<%= render partial: 'sys_backups/history', locals: { job: j } %>
</div>
<% html_title "#{j.name_was.presence || j.name} - #{l(:label_sb)}" %>
