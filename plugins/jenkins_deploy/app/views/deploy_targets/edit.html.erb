<h2><%= link_to l(:label_settings), settings_project_path(@project, :tab => 'deploys') %> &#187; <%= @target.name %></h2>

<%= labelled_form_for @target, :url => project_deploy_target_path(@project, @target), :html => { :method => :patch } do |f| %>
  <%= render :partial => 'form', :locals => { :f => f } %>
<% end %>

<% html_title l(:label_deploy_target) %>
