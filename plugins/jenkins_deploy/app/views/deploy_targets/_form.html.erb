<%= error_messages_for @target %>
<div class="box tabular">
  <p><%= f.text_field :name, :required => true, :size => 30, :maxlength => 60, :placeholder => '개발서버' %></p>
  <p><%= f.select :jenkins_server_id, JenkinsServer.sorted.map { |s| [s.name, s.id] }, { :required => true } %></p>
  <p><%= f.text_field :job_path, :required => true, :size => 60, :maxlength => 255, :placeholder => 'mainbiz/dev-deploy' %>
    <em class="info"><%= l(:text_job_path_info) %></em></p>
  <p><%= f.check_box :production %>
    <em class="info"><%= l(:text_production_info) %></em></p>
  <p><%= f.text_area :default_params, :rows => 4, :cols => 60, :placeholder => "BRANCH=develop" %>
    <em class="info"><%= l(:text_default_params_info) %></em></p>
</div>
<p class="form_btns">
  <%= link_to l(:button_cancel), settings_project_path(@project, :tab => 'deploys'), :class => 'btn_line' %>
  <%= submit_tag l(@target.new_record? ? :button_create : :button_save) %>
</p>
