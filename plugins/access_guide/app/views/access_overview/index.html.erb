<%# 관리 > 역할 및 권한 > 권한 한눈에 보기 탭 — 역할 × 영역 요약, 사용자 × 프로젝트 역할 (조회만, 바꾸려면 역할 편집·업무흐름 설정) %>
<div class="contextual">
  <%= link_to sprite_icon('workflows', l(:label_simple_workflows)), simple_workflows_path, :class => 'icon icon-workflows' %>
</div>

<h2><%= l(:label_role_and_permissions) %></h2>
<%= render :partial => 'roles/ag_tabs', :locals => { :current => :overview } %>
<p class="subtitle"><%= l(:text_access_overview) %></p>

<ul class="ag_legend">
  <li><%= access_level_tag('manage') %> <%= l(:text_access_level_manage) %></li>
  <li><%= access_level_tag('write') %> <%= l(:text_access_level_write) %></li>
  <li><%= access_level_tag('view') %> <%= l(:text_access_level_view) %></li>
  <li><%= access_level_tag('none') %> <%= l(:text_access_level_none) %></li>
</ul>

<h3 class="ag_sec"><%= l(:label_access_by_role) %></h3>
<div class="autoscroll">
<table class="list ag_tbl ag_matrix">
  <thead><tr>
    <th class="area"><%= l(:label_access_area) %></th>
    <% @roles.each do |role| %><th><%= link_to role.name, edit_role_path(role) %></th><% end %>
  </tr></thead>
  <tbody>
  <% AccessGuide::Areas::AREAS.each do |area| %>
    <tr>
      <th class="area"><%= l("label_access_area_#{area[:key]}") %></th>
      <% @roles.each do |role| %>
        <% level = AccessGuide::Areas.level(role, area) %>
        <td>
          <%= access_level_tag(level, access_perm_names(AccessGuide::Areas.granted(role, area))) %>
          <% if area[:key] == 'keys' && level != 'none' && role.permissions.include?(:whitelist_keys) %><span class="ag_note"><%= l(:label_access_whitelist_only) %></span><% end %>
        </td>
      <% end %>
    </tr>
  <% end %>
    <tr class="ag_wf">
      <th class="area"><%= l(:label_access_area_workflow) %></th>
      <% @roles.each do |role| %>
        <% level = AccessGuide::Areas.workflow_level(role, @closed_ids) %>
        <td>
          <%= content_tag(:span, l("label_access_wf_#{level}"), :class => "ag_lv lv_#{level}") %>
          <% if (missing = @missing[role.id]).any? && level != 'none' %>
            <span class="ag_warn" title="<%= missing.map(&:name).join(', ') %>"><%= l(:label_access_wf_missing, :count => missing.size) %></span>
          <% end %>
          <%= link_to l(:button_edit), simple_workflows_path(:role_id => role.id), :class => 'ag_edit' %>
        </td>
      <% end %>
    </tr>
    <tr class="ag_opt">
      <th class="area"><%= l(:field_assignable) %></th>
      <% @roles.each do |role| %><td><%= role.assignable? ? l(:general_text_Yes) : l(:general_text_No) %></td><% end %>
    </tr>
    <tr class="ag_opt">
      <th class="area"><%= l(:field_issues_visibility) %></th>
      <% @roles.each do |role| %><td><%= l(Role::ISSUES_VISIBILITY_OPTIONS.to_h[role.issues_visibility] || :label_none) %></td><% end %>
    </tr>
    <tr class="ag_opt">
      <th class="area"><%= l(:label_access_perm_count) %></th>
      <% @roles.each do |role| %><td><%= link_to l(:label_access_perm_count_value, :count => role.permissions.size), edit_role_path(role) %></td><% end %>
    </tr>
  </tbody>
</table>
</div>
<p class="ag_tip"><%= l(:text_access_tip) %></p>

<h3 class="ag_sec"><%= l(:label_access_by_user) %></h3>
<div class="autoscroll">
<table class="list ag_tbl ag_users">
  <thead><tr>
    <th class="area"><%= l(:label_user) %></th>
    <% @projects.each do |project| %><th><%= link_to project.name, settings_project_path(project, :tab => 'members') %></th><% end %>
  </tr></thead>
  <tbody>
  <% @users.each do |user| %>
    <% by_project = (@memberships[user.id] || []).index_by(&:project_id) %>
    <tr>
      <th class="area"><%= link_to user.name, edit_user_path(user) %><% if user.admin? %> <span class="ag_admin"><%= l(:field_admin) %></span><% end %></th>
      <% @projects.each do |project| %>
        <td>
          <% if (m = by_project[project.id]) %>
            <% m.roles.sort.each do |role| %><span class="ag_role"><%= role.name %></span><% end %>
          <% elsif user.admin? %>
            <span class="ag_dim"><%= l(:label_access_admin_all) %></span>
          <% else %>
            <span class="ag_dim">-</span>
          <% end %>
        </td>
      <% end %>
    </tr>
  <% end %>
  </tbody>
</table>
</div>
<p class="ag_tip"><%= l(:text_access_user_tip) %></p>

<% html_title l(:label_access_overview) %>
