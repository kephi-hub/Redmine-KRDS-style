<%# KRDS 게시판 목록 형식 — 원본: Redmine 6.1.6 app/views/documents/index.html.erb (새 문서 폼은 원본과 동일, 목록·검색조건 데이터: DocumentListPatch) %>
<div class="contextual">
<%= link_to sprite_icon('add', l(:label_document_new)), new_project_document_path(@project), :class => 'icon icon-add',
            :onclick => 'showAndScrollTo("add-document", "document_title"); return false;' if User.current.allowed_to?(:add_documents, @project) %>
</div>

<div id="add-document" style="display:none;">
<h2><%=l(:label_document_new)%></h2>
<%= labelled_form_for @document, :url => project_documents_path(@project), :html => {:multipart => true} do |f| %>
<%= render :partial => 'form', :locals => {:f => f} %>
<p>
  <%= submit_tag l(:button_create) %>
  <%= link_to l(:button_cancel), "#", :onclick => '$("#add-document").hide(); return false;' %>
</p>
<% end %>
</div>

<h2><%=l(:label_document_plural)%></h2>

<div id="document-list" class="doc_board">
<div class="list_bar">
  <p class="list_total">총 <strong><%= @documents.size %></strong>건</p>
  <%= form_tag(project_documents_path(@project), :method => :get, :class => 'list_search') do %>
    <%= hidden_field_tag 'sort_by', @sort_by, :id => nil %>
    <label for="doc_category"><%= l(:field_category) %></label>
    <%= select_tag 'category_id', options_from_collection_for_select(@categories, :id, :name, @category&.id), :id => 'doc_category', :include_blank => l(:label_all) %>
    <%= render :partial => 'krds/title_search', :locals => {:clear_url => (project_documents_path(@project, :sort_by => @sort_by) if @category || @q)} %>
  <% end %>
</div>
<% if @documents.empty? %>
<p class="nodata"><%= l(:label_no_data) %></p>
<% else %>
<ul class="doc_list">
<%= render :partial => 'documents/document', :collection => @documents %>
</ul>
<% end %>
</div>

<% content_for :sidebar do %>
  <h3><%= l(:label_sort) %></h3>
  <ul>
    <li><%= link_to(l(:field_category), {:sort_by => 'category', :category_id => @category&.id, :q => @q},
                    :class => (@sort_by == 'category' ? 'selected' :nil)) %></li>
    <li><%= link_to(l(:label_date), {:sort_by => 'date', :category_id => @category&.id, :q => @q},
                    :class => (@sort_by == 'date' ? 'selected' :nil)) %></li>
    <li><%= link_to(l(:field_title), {:sort_by => 'title', :category_id => @category&.id, :q => @q},
                    :class => (@sort_by == 'title' ? 'selected' :nil)) %></li>
    <li><%= link_to(l(:field_author), {:sort_by => 'author', :category_id => @category&.id, :q => @q},
                    :class => (@sort_by == 'author' ? 'selected' :nil)) %></li>
  </ul>
<% end %>

<% html_title(l(:label_document_plural)) -%>
