<%# 프로젝트 > 테스트 > 메뉴별 현황 %>
<%= render :partial => 'qa_test_cases/tabs', :locals => { :current => :menus } %>
<% if !@menus_on %>
  <p class="db_hintbox"><%= l(:text_qa_need_menu) %></p>
<% elsif @ordered.empty? %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% else %>
<ul class="db_stats mt_kpi">
  <li><span><%= l(:label_qa_m_screens) %></span><strong><%= @kpi[:screens] %></strong></li>
  <li><span><%= l(:label_qa_m_covered) %></span><strong><%= @kpi[:covered] %></strong></li>
  <li><span><%= l(:label_qa_m_cases) %></span><strong><%= @kpi[:cases] %></strong></li>
  <li><span><%= l(:label_qa_result_pass) %></span><strong><%= @kpi[:pass] %></strong></li>
  <li><span><%= l(:label_qa_result_fail) %></span><strong class="<%= 'qa_fail' if @kpi[:fail].positive? %>"><%= @kpi[:fail] %></strong></li>
  <li><span><%= l(:label_qa_progress) %></span><strong><%= @kpi[:cases].positive? ? (@kpi[:pass] * 100 / @kpi[:cases]) : 0 %>%</strong></li>
</ul>
<% can_edit = User.current.allowed_to?(:manage_qa_tests, @project) %>
<div class="autoscroll">
<table class="list qa_menus">
  <thead><tr><th class="name"><%= l(:label_qa_m_menu) %></th><th><%= l(:field_menu_screen_id, :default => '화면 ID') %></th><th><%= l(:label_qa_m_reqs) %></th><th><%= l(:label_qa_m_cases) %></th><th><%= l(:label_qa_result_pass) %></th><th><%= l(:label_qa_result_fail) %></th><th><%= l(:label_qa_result_none) %></th><th></th></tr></thead>
  <tbody>
  <% @ordered.each do |m, d| %>
    <% s = @stats[m.id] %>
    <tr class="<%= 'qa_empty' unless s %> <%= 'qa_d0' if d.zero? %>">
      <td class="name" style="padding-left:<%= 8 + d * 18 %>px"><%= link_to m.name, project_qa_test_cases_path(@project, :q => m.screen_id || m.name) %></td>
      <td><% if m.screen_id %><code><%= m.screen_id %></code><% end %></td>
      <td><%= @req_counts[m.id] || '-' %></td>
      <td><%= s ? s[:total] : '-' %></td>
      <td><%= s ? s[:pass] : '' %></td>
      <td class="<%= 'qa_fail' if s && s[:fail].positive? %>"><%= s ? s[:fail] : '' %></td>
      <td><%= s ? s[:none] : '' %></td>
      <td class="buttons"><% if can_edit %><%= link_to l(:label_qa_case_add), new_project_qa_test_case_path(@project, :menu_item_id => m.id), :class => 'qa_add' %><% end %></td>
    </tr>
  <% end %>
  </tbody>
</table>
</div>
<% end %>
<% html_title l(:label_qa_t_menus) %>
