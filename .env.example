# 복사해서 사용: cp .env.example .env && chmod 600 .env
# 비밀값 — Git 커밋·메신저 공유 금지. 분실하면 접속정보 복구 불가하므로 안전한 곳에 따로 백업
# 값 생성: openssl rand -hex 32   (SYS_API_KEY 는 openssl rand -hex 20)

POSTGRES_PASSWORD=
REDMINE_SECRET_KEY_BASE=
REDMINE_CIPHER_KEY=

# 서버마다 다른 값
REDMINE_PORT=3000
REDMINE_HOST_NAME=서버IP:3000
# 외부 프록시의 하위 경로로 서비스할 때 (예: https://www.nanwe.co.kr/pms) — 비우면 / 에서 서비스
#   REDMINE_RELATIVE_URL_ROOT=/pms
#   REDMINE_HOST_NAME=www.nanwe.co.kr/pms
#   REDMINE_PROTOCOL=https
REDMINE_RELATIVE_URL_ROOT=
REDMINE_PROTOCOL=http
REDMINE_SYS_API_KEY=
# PMS 백업 보관 일수 (setup/backup.sh, 비우면 14)
BACKUP_KEEP_DAYS=
