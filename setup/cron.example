# SVN/Git 커밋을 5분마다 가져와 일감에 연결 (refs/fixes/closes, @시간)
# 설치: KEY 를 .env 의 REDMINE_SYS_API_KEY 값으로 바꿔 /etc/cron.d/redmine_fetch 로 저장 후 chmod 600
*/5 * * * * root curl -s -m 240 -o /dev/null "http://localhost:3000/sys/fetch_changesets?key=KEY"

# PMS 백업: 매일 03:00 DB·첨부파일·Vault 키 (setup/backup.sh), 관리 > 백업 화면의 [지금 백업] 요청은 1분마다 확인
# 설치: /etc/cron.d/redmine_backup 로 저장 후 chmod 600 (경로는 서버의 Redmine 폴더로)
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
0 3 * * * root /root/redmine/setup/backup.sh >> /root/redmine/backup/cron.log 2>&1
* * * * * root /root/redmine/setup/backup.sh --if-requested >> /root/redmine/backup/cron.log 2>&1

# DB 관리: 프로젝트 DB 구조를 매일 새벽 3시에 저장 (바뀐 경우만, 변경 이력 화면에서 비교)
# 설치: /etc/cron.d/redmine_db_snapshot 로 저장 (경로는 서버의 Redmine 폴더로)
0 3 * * * root cd /root/redmine && docker compose exec -T -u redmine redmine sh -c 'SECRET_KEY_BASE=$REDMINE_SECRET_KEY_BASE bundle exec rake redmine:db_manage:snapshot' >> /var/log/redmine_db_snapshot.log 2>&1

# 자산 만료 알림 메일 (만료 30·7·1일 전·당일·다음 날) — 관리 > 메일 서버에서 메일 발송을 켜야 보냄
# 설치: /etc/cron.d/redmine_asset_notify 로 저장
10 8 * * * root cd /root/redmine && docker compose exec -T -u redmine redmine sh -c 'SECRET_KEY_BASE=$REDMINE_SECRET_KEY_BASE bundle exec rake redmine:ops_asset:notify' >> /var/log/redmine_asset_notify.log 2>&1

# 메뉴 구조도 화면 캡처: 캡처 설정의 자동 캡처가 매일·매주(월)인 사이트를 새벽 4시에 캡처
# 설치: /etc/cron.d/redmine_capture 로 저장 후 chmod 600
0 4 * * * root cd /root/redmine && docker compose exec -T -u redmine redmine sh -c 'SECRET_KEY_BASE=$REDMINE_SECRET_KEY_BASE bundle exec rake redmine:menu_tree:capture' >> /var/log/redmine_capture.log 2>&1

# SSH 터미널 — 1년 지난 접속 기록·화면 녹화 지우기 (매월 1일 04:30)
# 설치: /etc/cron.d/redmine_ssh_purge 로 저장 후 chmod 600
30 4 1 * * root cd /root/redmine && docker compose exec -T -u redmine redmine sh -c 'SECRET_KEY_BASE=$REDMINE_SECRET_KEY_BASE bundle exec rake redmine:ssh_console:purge DAYS=365' >> /var/log/redmine_ssh_purge.log 2>&1

# 자산 자동 확인 — 서버 정보 수집(SSH 접속정보 연결된 서버: OS·CPU·메모리·디스크) + 인증서·도메인 자산 HTTPS 인증서 확인 (매일 06:00)
# 인증서 유형 자산은 만료일이 인증서 만료일로 바뀜. 설치: /etc/cron.d/redmine_asset_probe 로 저장 후 chmod 600
0 6 * * * root cd /root/redmine && docker compose exec -T -u redmine redmine sh -c 'SECRET_KEY_BASE=$REDMINE_SECRET_KEY_BASE bundle exec rake redmine:ops_asset:probe' >> /var/log/redmine_asset_probe.log 2>&1
